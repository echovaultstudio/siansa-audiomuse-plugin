# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Your Navidrome, as Siansa reaches it (read only: its libraries, songs and their audio).
# The libraries to analyse are chosen on Siansa Beats' page.
NAVIDROME_URL=http://navidrome.local:4533
NAVIDROME_USER=
NAVIDROME_PASSWORD=

# Optional, for the comparison column: AudioMuse-AI with the Siansa plugin, and an API token if it has a login.
AUDIOMUSE_URL=http://audiomuse.local:8000
AUDIOMUSE_TOKEN=

# final0 (best, the default) or small0 (faster, a little less exact).
BEATS_MODEL=final0
# CPU cores the container may use, and the model's threads (0: as many as it has).
BEATS_CPUS=4
BEATS_THREADS=0

# Optional: the page asks for this password (user name: siansa).
BEATS_PASSWORD=

# With the cuda image and an NVIDIA GPU (docker-compose.gpu.yml): auto takes the GPU when the container has one;
# cpu, cuda or cuda:1 to choose. BEATS_FLOAT16=1 runs it in half precision on the GPU (faster, a little less exact).
BEATS_DEVICE=auto
BEATS_FLOAT16=0
