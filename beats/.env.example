# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# No password goes in here (0.24.0): your music servers, the page's password and the app's key are set on
# Siansa Beats' page, under Setup, and kept hashed or encrypted.

# final0 (best, the default) or small0 (faster, a little less exact).
BEATS_MODEL=final0
# CPU cores the container may use, and the model's threads (0: as many as it has).
BEATS_CPUS=4
BEATS_THREADS=0

# Optional: the key the kept secrets are encrypted with, to keep it out of the data volume (any long text).
# Without it a key file is made in the data volume. Changing it means entering the servers' passwords again.
BEATS_SECRET_KEY=

# info, or debug for every step of every song in the log (the page's Debug details switch changes it too).
LOG_LEVEL=info

# With the cuda image and an NVIDIA GPU (docker-compose.gpu.yml): auto takes the GPU when the container has one;
# cpu, cuda or cuda:1 to choose. BEATS_FLOAT16=1 runs it in half precision on the GPU (faster, a little less exact).
BEATS_DEVICE=auto
BEATS_FLOAT16=0
